
# PostgreSQL configuration
DB_USER=aegistwin
DB_PASSWORD=REPLACE_WITH_SECURE_PASSWORD
DB_NAME=aegistwin_db
DB_HOST=postgres
DB_PORT=5432

# PostgreSQL-backed gateway
AEGISTWIN_POSTGRES_RUNTIME_ENABLED=true

# Management API authentication
AEGISTWIN_VIEWER_KEY=REPLACE_WITH_VIEWER_KEY
AEGISTWIN_SECURITY_KEY=REPLACE_WITH_SECURITY_KEY
AEGISTWIN_ADMIN_KEY=REPLACE_WITH_ADMIN_KEY
# Runtime AI gateway authentication
AEGISTWIN_RUNTIME_API_KEY=REPLACE_WITH_STRONG_RUNTIME_KEY
AEGISTWIN_RUNTIME_TENANT_ID=REPLACE_WITH_VALID_TENANT_UUID
AEGISTWIN_RUNTIME_USER_ID=REPLACE_WITH_USER_ID
AEGISTWIN_RUNTIME_AGENT_ID=REPLACE_WITH_VALID_AGENT_UUID